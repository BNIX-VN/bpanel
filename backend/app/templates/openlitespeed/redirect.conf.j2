# BPanel managed redirect vhost: {{ domain }} -> {{ redirect_target }}
# BPANEL REDIRECT OWNER {{ redirect_owner }}
# Generated by BPanel - do not edit manually.
#
# A redirect domain gets a vhost of its own, exactly as nginx gives it its own
# server block. That is not a stylistic choice: OpenLiteSpeed ignores
# RewriteCond in the rewrite blocks we generate - verified on a live server
# with a condition that could never match, which still fired its rule - so a
# host-based `RewriteCond %{HTTP_HOST}` inside the main vhost redirected every
# hostname the site owned, including its aliases and the primary domain.
#
# Here the rule needs no condition at all: this vhost only ever receives the
# hostname mapped to it, so redirecting everything is precisely correct.

docRoot                   {{ root_path }}/{{ document_root }}

vhDomain                  {{ domain }}
vhAliases                 www.{{ domain }}

enableGzip                1

errorlog {{ error_log }} {
    useServer             0
    logLevel              WARN
    rollingSize           10M
}

accesslog {{ access_log }} {
    useServer             0
    rollingSize           100M
    keepDays              30
}

{% if has_ssl %}
vhssl {
    keyFile               {{ ssl_key_path }}
    certFile              {{ ssl_cert_path }}
{% if ssl_ca_path %}
    caBundlePath          {{ ssl_ca_path }}
{% endif %}
    certChain             1
}
{% endif %}

{# Served before the redirect so this domain can be added to the primary's
   certificate: Let's Encrypt has to fetch the challenge over plain HTTP, and
   a 301 would send it to the primary domain instead. #}
context /.well-known/acme-challenge/ {
    type                  static
    location              {{ root_path }}/{{ document_root }}/.well-known/acme-challenge/
    allowBrowse           1
    addDefaultCharset     off
}

context / {
    type                  null
    location              {{ root_path }}/{{ document_root }}
    allowOverride         0

    rewrite {
        enable            1
        rewriteRules      <<<END_RULES
RewriteRule ^(.*)$ {{ redirect_target }}/$1 [R={{ redirect_code }},L]
END_RULES
    }
}
