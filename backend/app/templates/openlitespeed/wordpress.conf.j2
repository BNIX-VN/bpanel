# BPanel managed vhost: {{ domain }}
# App type: wordpress
# Generated by BPanel - do not edit manually.

docRoot                   {{ root_path }}/{{ document_root }}

vhDomain                  {{ domain }}
{% for alias in aliases %}
vhAliases                 {{ alias }}
{% endfor %}

enableGzip                1
enableBr                  1

index  {
    useServer             0
    indexFiles            index.php, index.html
}

errorlog {{ error_log }} {
    useServer             0
    logLevel              WARN
    rollingSize           10M
}

accesslog {{ access_log }} {
    useServer             0
    rollingSize           100M
    keepDays              30
    logReferer            1
    logUserAgent          1
}

{% if has_ssl %}
vhssl {
    keyFile               {{ ssl_key_path }}
    certFile              {{ ssl_cert_path }}
{% if ssl_ca_path %}
    caBundlePath          {{ ssl_ca_path }}
{% endif %}
    certChain             1
}
{% endif %}

{% if waf_enabled %}
# BPANEL WAF BEGIN
module mod_security {
    modsecurity           on
    modsecurity_rules_file  {{ waf_rules_file }}
}
# BPANEL WAF END
{% endif %}

{% if lsphp_app %}
extprocessor {{ lsphp_app }} {
    type                  lsapi
    address               UDS://{{ lsphp_socket }}
    maxConns              100
    env                   LSAPI_CHILDREN=100
    initTimeout           60
    retryTimeout          0
    persistConn           1
    pcKeepAliveTimeout    60
    respBuffer            0
    autoStart             2
    path                  {{ lsphp_path }}
    extUser               {{ linux_user }}
    extGroup              {{ linux_user }}
    backlog               100
    instances             1
    priority              0
    memSoftLimit          2048M
    procSoftLimit         1000
    procHardLimit         1200
}

scripthandler {
    add                   lsapi:{{ lsphp_app }} php
}
{% endif %}

{# The challenge is served from the site's OWN docroot, not the shared
   /var/www/bpanel-acme the nginx side uses. A customer vhost runs with
   `restrained 1` - OpenLiteSpeed's defence against a site symlinking its way
   out of its docroot, which nginx gets from disable_symlinks - and that also
   blocks a static context pointing anywhere outside. Verified live: with the
   shared webroot the challenge 404'd and no certificate could ever be issued.
   A dedicated static context keeps the file away from PHP and from the
   front-controller rewrite. #}
context /.well-known/acme-challenge/ {
    type                  static
    location              {{ root_path }}/{{ document_root }}/.well-known/acme-challenge/
    allowBrowse           1
    addDefaultCharset     off
}

{% include "_denied_paths.j2" %}
context / {
    type                  null
    location              {{ root_path }}/{{ document_root }}
    allowOverride         all

    addDefaultCharset     off

    phpIniOverride  {
        php_admin_flag    log_errors on
        php_admin_value   error_log {{ php_error_log }}
        php_admin_value   open_basedir {{ root_path }}/:/tmp/
    }

    {# Exactly ONE rewrite block per context: OpenLiteSpeed keeps only the
       last one it parses, so splitting "inherit" and our own rules into two
       blocks silently threw the rules away. Sensitive paths are blocked by
       the accessControl contexts above, not from here - [F] in a rewrite rule
       does not deny on OLS. #}
    rewrite {
        enable            1
        inherit           1
{% if lsphp_app %}
        rewriteRules      <<<END_RULES
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
END_RULES
{% endif %}
    }
    extraHeaders <<<END_HEADERS
{% if hsts_header %}{{ hsts_header }}
{% endif %}{{ security_headers }}
Content-Security-Policy: {{ csp_header }}
END_HEADERS
}



{# LSCache-equivalent: always on for WordPress, same as nginx's FastCGI cache #}
# BPANEL LSCACHE BEGIN
rewrite {
    enable                1
    rewriteRules          <<<END_RULES
RewriteCond %{REQUEST_METHOD} POST
RewriteRule .* - [E=Cache-Control:v=no-cache]
RewriteCond %{QUERY_STRING} !=""
RewriteRule .* - [E=Cache-Control:v=no-cache]
RewriteCond %{HTTP_COOKIE} (comment_author|wordpress_[a-f0-9]+|wordpress_logged_in|wp-postpass|woocommerce_items_in_cart|woocommerce_cart_hash|wp_woocommerce_session) [NC]
RewriteRule .* - [E=Cache-Control:v=no-cache]
END_RULES
}
# BPANEL LSCACHE END
