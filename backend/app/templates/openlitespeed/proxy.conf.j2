# BPanel managed vhost: {{ domain }}
# App type: application (proxied to a locally installed app)
# Generated by BPanel - do not edit manually.

docRoot                   {{ root_path }}/{{ document_root }}

vhDomain                  {{ domain }}
{% for alias in aliases %}
vhAliases                 {{ alias }}
{% endfor %}

enableGzip                1
enableBr                  1

errorlog {{ error_log }} {
    useServer             0
    logLevel              WARN
    rollingSize           10M
}

accesslog {{ access_log }} {
    useServer             0
    rollingSize           100M
    keepDays              30
    logReferer            1
    logUserAgent          1
}

{% if has_ssl %}
vhssl {
    keyFile               {{ ssl_key_path }}
    certFile              {{ ssl_cert_path }}
{% if ssl_ca_path %}
    caBundlePath          {{ ssl_ca_path }}
{% endif %}
    certChain             1
}
{% endif %}

{% if waf_enabled %}
# BPANEL WAF BEGIN
module mod_security {
    modsecurity           on
    modsecurity_rules_file  {{ waf_rules_file }}
}
# BPANEL WAF END
{% endif %}

{% if http_flood_enabled %}
{{ http_flood_block }}
{% endif %}

{% include "_denied_paths.j2" %}
# BPANEL PROXY BEGIN
# OLS's proxy handler passes Upgrade/Connection through on its own - no
# equivalent to nginx's $connection_upgrade map is needed for WebSockets.
extprocessor bpanel_app_{{ domain | replace(".", "_") | replace("-", "_") }} {
    type                    proxy
    address                 127.0.0.1:{{ app_port }}
    maxConns                200
    initTimeout             {{ proxy_timeout }}
    retryTimeout            0
    respBuffer              0
}

context / {
    type                    proxy
    handler                 bpanel_app_{{ domain | replace(".", "_") | replace("-", "_") }}
    addDefaultCharset       off
    extraHeaders <<<END_HEADERS
{% if hsts_header %}{{ hsts_header }}
{% endif %}{{ security_headers }}
END_HEADERS
}
# BPANEL PROXY END

{# The challenge is served from the site's OWN docroot, not the shared
   /var/www/bpanel-acme the nginx side uses. A customer vhost runs with
   `restrained 1` - OpenLiteSpeed's defence against a site symlinking its way
   out of its docroot, which nginx gets from disable_symlinks - and that also
   blocks a static context pointing anywhere outside. Verified live: with the
   shared webroot the challenge 404'd and no certificate could ever be issued.
   A dedicated static context keeps the file away from PHP and from the
   front-controller rewrite. #}
context /.well-known/acme-challenge/ {
    type                  static
    location              {{ root_path }}/{{ document_root }}/.well-known/acme-challenge/
    allowBrowse           1
    addDefaultCharset     off
}

{% for redirect in redirects %}
rewrite {
    enable                1
    rewriteRules          <<<END_RULES
RewriteCond %{HTTP_HOST} ^(www\.)?{{ redirect.source }}$ [NC]
RewriteRule ^(.*)$ {% if redirect.target %}{{ redirect.target }}{% else %}https://{{ domain }}{% endif %}$1 [R={{ redirect.code }},L]
END_RULES
}
{% endfor %}
